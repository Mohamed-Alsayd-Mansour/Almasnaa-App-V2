# Dummy values only. Copy to .env (never commit .env). Used by scripts/migrate_v1.py on a trusted machine.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=put-service-role-key-here-never-in-flutter
SUPABASE_DB_URL=postgresql://postgres:YOUR-DB-PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres
# Initial passwords (6 chars min, format @NNNN@). Change them after first login.
SEED_PASSWORD_ADMIN=
SEED_PASSWORD_MANSOUR=
SEED_PASSWORD_QADRI=
